MERGE (n:PartSlot {platform: $platform, revision: $revision, slot: "charge-port-module"}) SET n.label = "Charge-port module", n.kind = "subassembly", n.side = "L", n.prefix = "CPM", n.sideSuffix = null, n.partNumber = "CP-MOD-300", n.partRevision = "A", n.sourcing = "in_house", n.supplierId = null, n.supplierBatchCode = null, n.manufacturingLotCode = "DEMO-ASM-LOT-01", n.workOrderId = "WO-DEMO-0100", n.processStepId = "chargeport-install", n.manufacturingTeamId = "TEAM-ASSEMBLY", n.synonyms = ["charge port","charging port","charge door","charger inlet","port"], n.spec = "{\"inlet\":\"CCS2 (demo)\",\"mounting\":\"4x M6 to rear quarter\"}" WITH n MATCH (z:Zone {platform: $platform, revision: $revision, id: "rear-quarter-left"}) MERGE (n)-[:IN_ZONE]->(z) WITH n MATCH (s:System {platform: $platform, revision: $revision, id: "charging"}) MERGE (n)-[:IN_SYSTEM]->(s);
