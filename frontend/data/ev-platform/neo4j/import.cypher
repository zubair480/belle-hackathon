// Link a vehicle's serialized entities to their design slot (run after Codey's entity seed):
// MATCH (e:Entity {workspaceId: $ws}) MATCH (n:PartSlot {platform: $platform, revision: $revision}) WHERE e.id STARTS WITH n.prefix + '-' AND (n.sideSuffix IS NULL OR e.id ENDS WITH '-' + n.sideSuffix) MERGE (e)-[:INSTANCE_OF_SLOT]->(n);
