// RecallRadius EV-PLATFORM-1 wiring design import (synthetic demo data). Generated by export-neo4j.mjs.
// Namespace every node with platform/revision so seeds only touch their own data.
CREATE CONSTRAINT platform_slot IF NOT EXISTS FOR (n:PartSlot) REQUIRE (n.platform, n.revision, n.slot) IS UNIQUE;
CREATE CONSTRAINT platform_wire IF NOT EXISTS FOR (n:Wire) REQUIRE (n.platform, n.revision, n.id) IS UNIQUE;
CREATE CONSTRAINT platform_circuit IF NOT EXISTS FOR (n:Circuit) REQUIRE (n.platform, n.revision, n.id) IS UNIQUE;
CREATE CONSTRAINT platform_connector IF NOT EXISTS FOR (n:Connector) REQUIRE (n.platform, n.revision, n.id) IS UNIQUE;
:param platform => "EV-PLATFORM-1";
:param revision => "v1";
MERGE (p:Platform {id: $platform, revision: $revision}) SET p.name = "EV-PLATFORM-1", p.synthetic = true;
MERGE (z:Zone {platform: $platform, revision: $revision, id: "front-bay"}) SET z.name = "Front bay";
