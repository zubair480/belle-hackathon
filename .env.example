# RecallRadius environment variable NAMES (placeholders only; never commit real values).
# Copy to .env.local for local development. Everything here is read server-side only.

# --- Neo4j (Codey seeds; Zubair verifies at final integration) ---
NEO4J_URI=neo4j+s://<your-aura-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<placeholder>
NEO4J_DATABASE=neo4j

# --- Synthetic demo context (server-configured; NOT production authentication) ---
# The server derives workspace/actor from these values. Browsers cannot supply them.
RECALL_WORKSPACE_ID=synthetic-co-packer
RECALL_DEMO_ACTOR_ID=qa-reviewer-demo
# Namespace prefix for seeded synthetic graph records so seeds touch only their own data.
RECALL_GRAPH_NAMESPACE=recallradius-demo

# --- Domain services wiring (Zubair) ---
# "graph" = Codey's real Neo4j-backed services (default at final integration).
# "double" = in-memory typed service double for route development/tests. Explicit setting only;
#            a failed real service is never silently replaced by the double.
RECALL_SERVICES=graph

# --- Runtime AI for supplier-alert extraction (optional, Zubair) ---
# Provider is replaceable. "none" keeps manual entry only. "stub" is a clearly labeled development stub.
# Live providers require an explicitly funded API credential; Qoder IDE credits and Claude
# subscriptions do NOT fund application API calls.
RECALL_AI_PROVIDER=none
RECALL_AI_API_KEY=<placeholder>
RECALL_AI_MODEL=<provider model id>
RECALL_AI_TIMEOUT_MS=15000

# --- Frontend development mocks (Ali) ---
# Visible sample/mock mode for UI development. Must be "false" for the final integrated demo.
NEXT_PUBLIC_RECALL_UI_MOCKS=false
